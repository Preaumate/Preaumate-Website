# =============================================================================
# .env.example  —  copy this to .env.local for local development
# =============================================================================
#
# HOW TO USE
# ──────────
# 1. Copy this file:   cp .env.example .env.local
# 2. Fill in the values (see SECURITY_SETUP.md for where to find them)
# 3. .env.local is already in .gitignore — it will NOT be committed to Git
#
# IMPORTANT: Never put real secret values in .env.example
#            .env.example is safe to commit. .env.local is not.
# =============================================================================

# ── Development (use these test values while developing locally) ──────────────

# Cloudflare Turnstile test site key — always passes in dev, never ask real users
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADU7MZh5Jy3wN_IO

# Your local Worker address when running 'wrangler dev'
# VITE_WORKER_URL=http://localhost:8787
VITE_WORKER_URL=http://preaumatecontactform.reaunald.workers.dev

# ── Production (replace with real values before deploying) ───────────────────
# Uncomment and fill in when building for production:

# VITE_TURNSTILE_SITE_KEY=your_real_turnstile_site_key_here
# VITE_WORKER_URL=https://preaumate-contact.YOUR-SUBDOMAIN.workers.dev
